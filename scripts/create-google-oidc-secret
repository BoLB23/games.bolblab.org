#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/create-google-oidc-secret [--context <kubectl-context>]

Interactively configures games-secrets for the Google OIDC deployment. It
generates the OIDC transaction secret locally and does not write secrets to a
file or print them. If a SESSION_SECRET already exists, it is retained so
current sessions are not invalidated.
EOF
}

CONTEXT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --context) CONTEXT="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Error: unknown parameter: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if ! command -v kubectl >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  echo "Error: kubectl, openssl, and python3 are required." >&2
  exit 1
fi

KUBECTL=(kubectl)
if [ -n "$CONTEXT" ]; then KUBECTL+=(--context "$CONTEXT"); fi
NAMESPACE="bolblab-games"

"${KUBECTL[@]}" apply -f "$(cd "$(dirname "$0")/.." && pwd)/k8s/namespace.yaml"
SESSION_SECRET=""
SECRET_EXISTS=false
if EXISTING_SECRET_JSON="$("${KUBECTL[@]}" -n "$NAMESPACE" get secret games-secrets -o json 2>/dev/null)"; then
  SECRET_EXISTS=true
  EXISTING_SESSION_SECRET_B64="$(printf '%s' "$EXISTING_SECRET_JSON" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("data", {}).get("SESSION_SECRET", ""), end="")')"
  if [ -n "$EXISTING_SESSION_SECRET_B64" ]; then
    SESSION_SECRET="$(printf '%s' "$EXISTING_SESSION_SECRET_B64" | python3 -c 'import base64, sys; print(base64.b64decode(sys.stdin.read()).decode(), end="")')"
    echo "Preserving the existing SESSION_SECRET."
  fi
fi

read -r -p "Google OAuth client ID: " OIDC_CLIENT_ID
read -r -s -p "Google OAuth client secret: " OIDC_CLIENT_SECRET
printf '\n'
read -r -p "Verified Google account to make overlord (email): " OVERLORD_EMAIL

if [ -z "$OIDC_CLIENT_ID" ] || [ -z "$OIDC_CLIENT_SECRET" ] || [ -z "$OVERLORD_EMAIL" ]; then
  echo "Error: client ID, client secret, and overlord email are required." >&2
  exit 1
fi
if [[ "$OIDC_CLIENT_ID$OIDC_CLIENT_SECRET$OVERLORD_EMAIL" == *$'\n'* || "$OIDC_CLIENT_ID$OIDC_CLIENT_SECRET$OVERLORD_EMAIL" == *$'\r'* ]]; then
  echo "Error: entered values cannot contain newlines." >&2
  exit 1
fi

if [ -z "$SESSION_SECRET" ]; then
  SESSION_SECRET="$(openssl rand -base64 48)"
  echo "Generated a new SESSION_SECRET."
fi
OIDC_TRANSACTION_SECRET="$(python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())')"

printf '%s\n' \
  "SESSION_SECRET=$SESSION_SECRET" \
  "OIDC_CLIENT_ID=$OIDC_CLIENT_ID" \
  "OIDC_CLIENT_SECRET=$OIDC_CLIENT_SECRET" \
  "OIDC_CALLBACK_URL=https://games.bolblab.org/api/v1/auth/callback" \
  "OIDC_TRANSACTION_SECRET=$OIDC_TRANSACTION_SECRET" \
  "OVERLORD_EMAIL=$OVERLORD_EMAIL" \
  | if [ "$SECRET_EXISTS" = true ]; then
      python3 -c '
import base64
import json
import os
import sys

values = {}
for line in sys.stdin:
    key, value = line.rstrip("\n").split("=", 1)
    values[key] = base64.b64encode(value.encode()).decode()
print(json.dumps({"data": values}))
' | "${KUBECTL[@]}" -n "$NAMESPACE" patch secret games-secrets --type=merge --patch-file=/dev/stdin
    else
      "${KUBECTL[@]}" -n "$NAMESPACE" create secret generic games-secrets \
        --from-env-file=/dev/stdin
    fi

unset SESSION_SECRET OIDC_TRANSACTION_SECRET OIDC_CLIENT_SECRET
echo "Configured games-secrets without removing unrelated existing keys. Next create games-bolblab-org-tls, publish OIDC-mode images, then run scripts/deploy --context <kubectl-context> --tag <tag>."
