#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/deploy [--tag <tag>] [--context <context>] [--image-repo <repo>]
                      [--oidc|--development]

Deploys the API and web images to bolblab-games. Production OIDC mode is the
default. The TLS ingress is required for production and is used only when the
games-bolblab-org-tls secret is present.

--oidc explicitly selects production Google OIDC mode.
--development is rejected for cluster deployment; use npm run dev or the
explicit local development Kustomize overlay instead.
Production requires an OIDC-ready games-secrets secret and a matching
production config map.
EOF
}

NAMESPACE="bolblab-games"
CONTEXT=""
IMAGE_REPO="ghcr.io/bolb23/games.bolblab.org"
TAG="$(git rev-parse --short HEAD 2>/dev/null || echo latest)"
OIDC=true
MODE_EXPLICIT=""

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: required command not found: $1" >&2
    exit 1
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tag)
      TAG="${2:-}"
      shift 2
      ;;
    --context)
      CONTEXT="${2:-}"
      shift 2
      ;;
    --image-repo)
      IMAGE_REPO="${2:-}"
      shift 2
      ;;
    --oidc)
      if [ "$MODE_EXPLICIT" = development ]; then
        echo "Error: --oidc and --development cannot be combined." >&2
        exit 1
      fi
      MODE_EXPLICIT=oidc
      OIDC=true
      shift
      ;;
    --development)
      if [ "$MODE_EXPLICIT" = oidc ]; then
        echo "Error: --oidc and --development cannot be combined." >&2
        exit 1
      fi
      MODE_EXPLICIT=development
      OIDC=false
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown parameter: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ -z "$TAG" ] || [ -z "$IMAGE_REPO" ]; then
  echo "Error: --tag and --image-repo cannot be empty" >&2
  exit 1
fi

if [ "$OIDC" = true ] && [ "$CONTEXT" = "" ]; then
  echo "Error: --context is required for production OIDC deployment." >&2
  exit 1
fi

if [ "$OIDC" = false ]; then
  echo "Error: --development does not deploy the hardened production manifest." >&2
  echo "Use npm run dev for local development, or render k8s/overlays/development explicitly for a private local cluster." >&2
  exit 1
fi

require_command kubectl
require_command sed
require_command grep
require_command base64

KUBECTL=(kubectl)
if [ -n "$CONTEXT" ]; then
  KUBECTL+=(--context "$CONTEXT")
fi

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST_DIR="$ROOT_DIR/k8s"
API_IMAGE="$IMAGE_REPO/api:$TAG"
WEB_IMAGE="$IMAGE_REPO/web:$TAG"

echo "Deploying $API_IMAGE and $WEB_IMAGE to $NAMESPACE"

"${KUBECTL[@]}" apply -f "$MANIFEST_DIR/namespace.yaml"
"${KUBECTL[@]}" apply -f "$MANIFEST_DIR/pvc.yaml"
"${KUBECTL[@]}" apply -f "$MANIFEST_DIR/service.yaml"

HAS_TLS=false
if "${KUBECTL[@]}" -n "$NAMESPACE" get secret games-bolblab-org-tls >/dev/null 2>&1; then
  HAS_TLS=true
fi

if [ "$HAS_TLS" = true ] || [ "$OIDC" = true ]; then
  if [ "$HAS_TLS" = true ]; then
    echo "Using existing TLS secret games-bolblab-org-tls"
  else
    echo "Applying the TLS ingress and waiting for cert-manager to create games-bolblab-org-tls"
  fi
  "${KUBECTL[@]}" apply -f "$MANIFEST_DIR/ingress-tls.yaml"
else
  echo "TLS secret not found; serving HTTP only"
  "${KUBECTL[@]}" apply -f "$MANIFEST_DIR/ingress.yaml"
fi

if [ "$OIDC" = true ]; then
  for _attempt in $(seq 1 60); do
    if "${KUBECTL[@]}" -n "$NAMESPACE" get secret games-bolblab-org-tls >/dev/null 2>&1; then
      HAS_TLS=true
      break
    fi
    sleep 5
  done
  if [ "$HAS_TLS" != true ]; then
    echo "Error: games-bolblab-org-tls was not created within five minutes. Check cert-manager and the Cloudflare DNS challenge." >&2
    exit 1
  fi
fi

if ! "${KUBECTL[@]}" -n "$NAMESPACE" get secret games-secrets >/dev/null 2>&1; then
  echo "Error: games-secrets is required in namespace $NAMESPACE" >&2
  echo "Create it from k8s/secret.example.yaml after replacing SESSION_SECRET (and the OIDC keys for --oidc)." >&2
  exit 1
fi

if [ "$OIDC" = true ]; then
  "${KUBECTL[@]}" apply -f "$MANIFEST_DIR/overlays/google-oidc/oidc-config.example.yaml"
  for _key in OIDC_CLIENT_ID OIDC_CLIENT_SECRET OIDC_CALLBACK_URL OIDC_TRANSACTION_SECRET OVERLORD_EMAIL; do
    if ! "${KUBECTL[@]}" -n "$NAMESPACE" get secret games-secrets -o "jsonpath={.data.$_key}" | grep -q .; then
      echo "Error: games-secrets is missing required OIDC key: $_key" >&2
      exit 1
    fi
  done
  CALLBACK_URL="$("${KUBECTL[@]}" -n "$NAMESPACE" get secret games-secrets -o jsonpath='{.data.OIDC_CALLBACK_URL}' | base64 --decode)"
  if [ "$CALLBACK_URL" != "https://games.bolblab.org/api/v1/auth/callback" ]; then
    echo "Error: OIDC_CALLBACK_URL must be the production HTTPS callback URL." >&2
    exit 1
  fi
  AUTH_MODE="$("${KUBECTL[@]}" -n "$NAMESPACE" get configmap games-oidc-config -o jsonpath='{.data.AUTH_MODE}' 2>/dev/null || true)"
  APP_ENV="$("${KUBECTL[@]}" -n "$NAMESPACE" get configmap games-oidc-config -o jsonpath='{.data.APP_ENV}' 2>/dev/null || true)"
  if [ "$AUTH_MODE" != "oidc" ] || [ "$APP_ENV" != "production" ]; then
    echo "Error: games-oidc-config must set AUTH_MODE=oidc and APP_ENV=production." >&2
    exit 1
  fi
  "${KUBECTL[@]}" kustomize --load-restrictor LoadRestrictionsNone "$MANIFEST_DIR/overlays/google-oidc" \
    | sed "s|image: .*|image: $API_IMAGE|" \
    | "${KUBECTL[@]}" apply -f -
else
  sed "s|image: .*|image: $API_IMAGE|" "$MANIFEST_DIR/deployment-api.yaml" | "${KUBECTL[@]}" apply -f -
fi
sed "s|image: .*|image: $WEB_IMAGE|" "$MANIFEST_DIR/deployment-web.yaml" | "${KUBECTL[@]}" apply -f -

"${KUBECTL[@]}" -n "$NAMESPACE" rollout status deployment/games-api --timeout=5m
"${KUBECTL[@]}" -n "$NAMESPACE" rollout status deployment/games-web --timeout=5m
"${KUBECTL[@]}" -n "$NAMESPACE" get deployment,service,ingress,pods
