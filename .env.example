APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8001
DATABASE_URL=sqlite:///../../data/game-platform.db

SESSION_SECRET=replace-with-a-development-secret
SESSION_COOKIE_NAME=game_platform_session
SESSION_COOKIE_SECURE=false

# Local testing uses the seeded-player picker. To use Google OIDC, set both this
# value and VITE_AUTH_MODE to oidc, then fill in the values from Google Cloud.
AUTH_MODE=development
VITE_AUTH_MODE=development
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=your-google-oauth-client-secret
# OIDC_CALLBACK_URL=https://your-catalog-host/api/v1/auth/callback
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OIDC_TRANSACTION_SECRET=your-fernet-key
# The verified Google account promoted to the platform overlord on login.
# Required only for the production OIDC deployment; do not put a real address in this example.
# OVERLORD_EMAIL=overlord@example.invalid
# SESSION_TTL_SECONDS=28800

CATALOG_ORIGIN=http://localhost:6183
SAMPLE_GAME_ORIGIN=http://localhost:6184
FLAPPY_MIKE_ORIGIN=http://localhost:6185
# Use launch URLs only when a game is served beneath a path of a shared origin.
# SAMPLE_GAME_LAUNCH_URL=https://games.example.test/games/sample-game/
# FLAPPY_MIKE_LAUNCH_URL=https://games.example.test/games/flappy-mike/
# Comma-separated, exact origins for independently hosted games. No paths.
# Local Milton Estates: http://localhost:5183
# Production Milton Estates: https://milton.games.bolblab.org
GAME_CORS_ALLOWED_ORIGINS=http://localhost:5183

# Milton remains hidden unless explicitly enabled. Set true for local E2E work
# after starting the independent Milton Estates dev server on :5183.
MILTON_ESTATES_ORIGIN=http://localhost:5183
# Optional path-specific Milton launch URL when it shares the catalog origin.
# MILTON_ESTATES_LAUNCH_URL=https://games.bolblab.org/games/milton-estates/
MILTON_ESTATES_ENABLED=false
# Enables the platform cloud-save capability. Milton's local GameStore remains unchanged.
MILTON_ESTATES_CLOUD_SAVES_ENABLED=false

# A single save and all slots for one player/game are bounded independently.
CLOUD_SAVE_MAX_BYTES=524288
CLOUD_SAVE_TOTAL_MAX_BYTES=2097152

VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_SAMPLE_GAME_URL=http://localhost:6184
VITE_FLAPPY_MIKE_URL=http://localhost:6185
VITE_CATALOG_URL=http://localhost:6183
